{
  "name": "devaid",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @devaid/server --filter @devaid/web dev",
    "build": "pnpm --filter @devaid/server build && pnpm --filter @devaid/web build",
    "test": "pnpm --filter @devaid/server test && pnpm --filter @devaid/web test",
    "typecheck": "pnpm --filter @devaid/ai-contracts typecheck && pnpm --filter @devaid/server typecheck && pnpm --filter @devaid/web typecheck",
    "lint": "pnpm --filter @devaid/server lint && pnpm --filter @devaid/web lint",
    "format": "pnpm --filter @devaid/server format && pnpm --filter @devaid/web format",
    "format:check": "pnpm --filter @devaid/server format:check && pnpm --filter @devaid/web format:check",
    "preview": "pnpm --filter @devaid/web preview"
  }
}
